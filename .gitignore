# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Data — never commit large raw datasets
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.csv
*.parquet
*.h5
*.feather
*.pkl
*.pickle

# Reports — keep charts out of git unless small; keep structure
reports/charts/*
!reports/charts/.gitkeep
reports/performance/*
!reports/performance/.gitkeep

# Secrets / credentials — NEVER commit
.env
.env.*
*.key
*.pem
credentials.json
secrets.json
config.json
api_keys.txt

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
